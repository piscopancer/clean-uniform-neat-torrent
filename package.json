{
  "name": "clean-uniform-neat-torrent",
  "productName": "Clean Uniform Neat Torrent",
  "version": "0.5.1",
  "description": "Desktop BitTorrent client built on Electron, Effect and webtorrent",
  "author": "piscopancer <piscopancer@gmail.com>",
  "homepage": "https://github.com/piscopancer/clean-uniform-neat-torrent",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.ts",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "postinstall": "electron-builder install-app-deps",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "release": "release-it"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "effect": "^4.0.6",
    "electron-updater": "^6.8.11",
    "parse-torrent": "^11.0.24",
    "recharts": "^3.10.1",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@types/node": "^24.19.2",
    "@types/parse-torrent": "^11.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webtorrent": "^3.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.7.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "release-it": "^21.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zustand": "^5.0.16"
  }
}
